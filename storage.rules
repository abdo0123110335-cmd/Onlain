rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // أي مستخدم مسجّل دخول (مدير أو موظف) يقدر يرفع صور المستندات ويعرضها.
    // التحكم الحقيقي في مين يشوف بيانات أي عميل يتم فعلياً عبر قواعد
    // Firestore (firestore.rules) وليس هنا، لأن الصور نفسها مجرد ملفات.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
